# Wattle Health — Supabase project zbwvctztpdiugvwjwzbl (ap-southeast-2). Copy to .env.local.
# The publishable key is safe to commit: anon/authenticated can only read the published_* views (RLS on, no table policies).
NEXT_PUBLIC_SUPABASE_URL=https://zbwvctztpdiugvwjwzbl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_rm1rr-BPRDEdBLKamDactw_sDMe85yR

# Server only (never NEXT_PUBLIC_, never committed with a value): lets src/server/clinician.ts write
# provider_claims, provider_services, personal_profiles through the REST API. Absent = in-memory local mode.
SUPABASE_SERVICE_ROLE_KEY=

# Mode (src/mode.ts): "wattle" lists everything; "adhdme" narrows the whole app to ADHD support.
# The Profile switch and ?mode= override this per device.
NEXT_PUBLIC_APP_MODE=wattle

# Decisions loop and /admin (src/decisions, README "Decisions loop and admin"). Server only: never NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ADMIN_PASSWORD=
DECISIONS_API_KEY=
DECISIONS_REVIEW_WEBHOOK_URL=
DECISIONS_REVIEW_WEBHOOK_TOKEN=
